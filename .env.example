# Copy to .env.local for local development, or set these in Vercel.
# Everything is optional: without them the site runs with the questionnaire,
# file exports and GitHub, the demo dataset, and free unlocks in development.

# Public address the site is reached at, without the base path (canonical URLs,
# sitemap). Default: https://angebunden.ch
NEXT_PUBLIC_SITE_URL=https://angebunden.ch
# Path the app is served under. Default /whatshouldistudy (inside angebunden.ch);
# set to / once it has its own domain. Read at build time.
WSIS_BASE_PATH=
# Link to the source code, shown as «Open source» across the site.
# Default: https://github.com/moritzlauper/whatshouldistudy
NEXT_PUBLIC_SOURCE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Who runs the site, shown in the privacy notice and the imprint (e.g. "Name").
NEXT_PUBLIC_OPERATOR=
# Postal address for the imprint (required for the German and Austrian sites).
NEXT_PUBLIC_OPERATOR_ADDRESS=
# A second fast way to reach you besides email (§ 5 DDG), e.g. a phone number.
NEXT_PUBLIC_OPERATOR_PHONE=
# Swiss UID (CHE-…) or VAT number, if you have one.
NEXT_PUBLIC_OPERATOR_UID=
# Representative in the EU under Art. 27 GDPR (name, address), once appointed.
NEXT_PUBLIC_EU_REPRESENTATIVE=
# Extra origins Stripe may send buyers back to, comma-separated. The request's
# own origin, NEXT_PUBLIC_SITE_URL and the country domains are always allowed.
WSIS_ALLOWED_ORIGINS=

# ── Country sites ───────────────────────────────────────────────────────────
# Without these they live at /schweiz, /deutschland and /oesterreich. With their
# own domain (added to this Vercel project), set the URL; that host is then
# served the country's pages at its root.
NEXT_PUBLIC_CH_URL=
NEXT_PUBLIC_DE_URL=
NEXT_PUBLIC_AT_URL=
# Extra hosts per country, comma-separated (the URL's host and www. are automatic).
WSIS_CH_HOSTS=
WSIS_DE_HOSTS=
WSIS_AT_HOSTS=
# Names (defaults: wasstudiere, wassollichstudieren, wasstudierich).
NEXT_PUBLIC_CH_NAME=
NEXT_PUBLIC_DE_NAME=
NEXT_PUBLIC_AT_NAME=

# ── Sign-ins (client ids are public by design; no secrets needed) ──────────
# Every provider needs one redirect URI per domain: <domain>/whatshouldistudy/callback/<provider>.
# The country sites under that domain share it.

# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" →
# OAuth consent screen (external, scope youtube.readonly, add test users) →
# Credentials → OAuth client ID → Web application.
#   Authorised JavaScript origins: https://angebunden.ch
#                                  https://angebunden-7o69.vercel.app
#                                  http://localhost:3000
#   Authorised redirect URIs:      https://angebunden.ch/whatshouldistudy/callback/google
#                                  https://angebunden-7o69.vercel.app/whatshouldistudy/callback/google
#                                  http://localhost:3000/whatshouldistudy/callback/google
# Default: the client in lib/sources/oauth.ts. Only the client id, never the secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# developer.spotify.com → Dashboard → Create app → Web API. Redirect URIs:
#   https://angebunden.ch/whatshouldistudy/callback/spotify
#   https://angebunden-7o69.vercel.app/whatshouldistudy/callback/spotify
#   http://127.0.0.1:3000/whatshouldistudy/callback/spotify (Spotify refuses "localhost")
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# reddit.com/prefs/apps → create app → type "installed app". Reddit takes one
# redirect URI per app: https://angebunden.ch/whatshouldistudy/callback/reddit
NEXT_PUBLIC_REDDIT_CLIENT_ID=

# ── Paywall ─────────────────────────────────────────────────────────────────
# Stripe secret key (sk_live_… / sk_test_…, or a restricted rk_live_… with the
# permissions listed in the README). Without it, production shows no checkout
# and development unlocks for free. Products and prices: pnpm stripe:setup.
STRIPE_SECRET_KEY=
# Optional: a Stripe Price for the report other than the one with lookup key
# wsis_report, with a currency option per currency in lib/pricing.ts. Without
# either the price comes from lib/pricing.ts (17 in the visitor's currency).
STRIPE_PRICE_ID=
# Signs unlock tokens. Required with Stripe. Generate: openssl rand -base64 32
WSIS_TOKEN_SECRET=
# 1 = unlock for free in production too (e.g. for a beta).
WSIS_FREE_UNLOCK=

# ── Measurement (lib/measure.ts) ────────────────────────────────────────────
# All public by design. Without them no Google tag loads and the privacy notice
# says so. Events carry the step and the price, never results or history.
# Google Analytics 4 measurement id (G-…).
NEXT_PUBLIC_GA4_ID=
# Google Ads tag id (AW-…) and the labels of its conversion actions (the part
# after the slash in send_to: AW-123/AbC-dEf).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CHECKOUT_LABEL=
# Where consent is missing (EU/EEA and UK before a choice): advanced (default)
# loads the Google tag denied and sends cookieless pings for modelling; basic
# loads nothing until consent. Switzerland and the rest: on until refused.
NEXT_PUBLIC_CONSENT_MODE=
# 1 = Vercel Web Analytics (cookieless page views). Enable it in the Vercel
# project as well (Analytics tab).
NEXT_PUBLIC_VERCEL_ANALYTICS=

# ── Programme data ──────────────────────────────────────────────────────────
# Base URL of the data branch. Default: the whatshouldistudy-data branch of the
# repository Vercel deploys from; falls back to data/sample.
WSIS_DATA_URL=
