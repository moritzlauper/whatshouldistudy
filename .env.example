# Copy to .env.local for local development, or set these in Vercel.
# Everything is optional: without them the site runs with the questionnaire,
# file exports and GitHub, the demo dataset, and free unlocks in development.

# Public address the site is reached at, without the base path (canonical URLs,
# sitemap). Default: https://angebunden.ch
NEXT_PUBLIC_SITE_URL=https://angebunden.ch
# Path the app is served under. Default /whatshouldistudy (inside angebunden.ch);
# set to / once it has its own domain. Read at build time.
WSIS_BASE_PATH=
NEXT_PUBLIC_CONTACT_EMAIL=
# Who runs the site, shown in the privacy notice and the imprint (e.g. "Name").
NEXT_PUBLIC_OPERATOR=
# Postal address for the imprint (required for the German and Austrian sites).
NEXT_PUBLIC_OPERATOR_ADDRESS=
# Extra origins Stripe may send buyers back to, comma-separated. The request's
# own origin, NEXT_PUBLIC_SITE_URL and the country domains are always allowed.
WSIS_ALLOWED_ORIGINS=

# ── Country sites ───────────────────────────────────────────────────────────
# Without these they live at /schweiz, /deutschland and /oesterreich. With their
# own domain (added to this Vercel project), set the URL; that host is then
# served the country's pages at its root.
NEXT_PUBLIC_CH_URL=
NEXT_PUBLIC_DE_URL=
NEXT_PUBLIC_AT_URL=
# Extra hosts per country, comma-separated (the URL's host and www. are automatic).
WSIS_CH_HOSTS=
WSIS_DE_HOSTS=
WSIS_AT_HOSTS=
# Names (defaults: wasstudiere, wassollichstudieren, wasstudierich).
NEXT_PUBLIC_CH_NAME=
NEXT_PUBLIC_DE_NAME=
NEXT_PUBLIC_AT_NAME=

# ── Sign-ins (client ids are public by design; no secrets needed) ──────────
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" →
# Credentials → OAuth client ID → Web application.
#   Authorised JavaScript origins: https://angebunden.ch (and http://localhost:3000)
#   Authorised redirect URIs:      https://angebunden.ch/whatshouldistudy/callback/google
#                                  https://angebunden.ch/whatshouldistudy/schweiz/callback/google
#                                  https://angebunden.ch/whatshouldistudy/deutschland/callback/google
#                                  https://angebunden.ch/whatshouldistudy/oesterreich/callback/google
#                                  https://<country-domain>/callback/google (once one exists)
#   The same for Spotify and Reddit below.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# developer.spotify.com → Create app → Web API. Redirect URI:
#   https://angebunden.ch/whatshouldistudy/callback/spotify (and the country paths)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# reddit.com/prefs/apps → create app → type "installed app". Redirect URI:
#   https://angebunden.ch/whatshouldistudy/callback/reddit (and the country paths)
NEXT_PUBLIC_REDDIT_CLIENT_ID=

# ── Paywall ─────────────────────────────────────────────────────────────────
# Stripe secret key (sk_live_… / sk_test_…). Without it, production shows no
# checkout and development unlocks for free.
STRIPE_SECRET_KEY=
# Optional: an existing Stripe Price with a currency option per currency in
# lib/pricing.ts. Without it the price comes from lib/pricing.ts (15 in the
# visitor's currency, CHF 15 on the Swiss site, EUR 15 on the German and
# Austrian sites).
STRIPE_PRICE_ID=
# Signs unlock tokens. Required with Stripe. Generate: openssl rand -base64 32
WSIS_TOKEN_SECRET=
# 1 = unlock for free in production too (e.g. for a beta).
WSIS_FREE_UNLOCK=

# ── Programme data ──────────────────────────────────────────────────────────
# Base URL of the data branch. Default: the whatshouldistudy-data branch of the
# repository Vercel deploys from; falls back to data/sample.
WSIS_DATA_URL=
