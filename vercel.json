{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)docs' ':(exclude)test' ':(exclude)scripts' ':(exclude).agents' ':(exclude).claude' ':(exclude).github' ':(exclude)*.md' ':(exclude)skills-lock.json'",
  "git": {
    "deploymentEnabled": {
      "whatshouldistudy-data": false,
      "wohnungen": false,
      "wohnungen-probe": false,
      "besucherzahlen": false
    }
  }
}
