{
  "name": "whatshouldistudy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find what to study from your real digital footprint (YouTube, Spotify, Reddit, GitHub) plus a short psychometric check, matched against study programmes worldwide.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "stripe:setup": "node scripts/stripe-setup.ts",
    "data:us": "node scrapers/us-scorecard.ts",
    "data:fr": "node scrapers/fr-parcoursup.ts",
    "data:uk": "node scrapers/uk-discoveruni.ts",
    "data:research": "node scrapers/global-openalex.ts",
    "data:directory": "node scrapers/global-directory.ts",
    "data:build": "node scrapers/build.ts",
    "data:all": "node scrapers/run-all.ts",
    "data:sample": "node scrapers/build.ts --sample"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.9"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.30.1"
}
